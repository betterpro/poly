APP_NAME=polymarket-mm-bot
ENVIRONMENT=local
LOG_LEVEL=INFO

PAPER_TRADING=true
LIVE_TRADING_CONFIRMED=false
RUN_MODE=paper
STARTING_CAPITAL=10000
# Dashboard auth is REQUIRED. Without DASHBOARD_PASSWORD the dashboard refuses to
# serve anything except /health (fail closed), so set a strong value before deploying.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# How often the dashboard reloads the status snapshot from the DB (seconds).
# Higher = less DB egress. Minimum 5; default 15.
DASHBOARD_POLL_SECONDS=15

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/polymarket_mm
REDIS_URL=redis://redis:6379/0

POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
SIGNATURE_TYPE=0
# Base32 TOTP secret required to confirm the paper -> live switch from the dashboard.
# Generate with: python -m scripts.setup_live_totp
LIVE_TOTP_SECRET=

MAX_DAILY_LOSS=300
MAX_POSITION_PER_MARKET=200
MAX_TOTAL_EXPOSURE=1000
MAX_ORDER_SIZE=25
MAX_OPEN_ORDERS=20
MAX_MARKETS_TRADED=10
MAX_API_ERRORS=5
MAX_ORDER_FAILURES_PER_MARKET=3

MIN_VOLUME=10000
MIN_LIQUIDITY=2000
MIN_SPREAD=0.01
MARKET_SCORE_THRESHOLD=70
MIN_TIME_TO_RESOLUTION_HOURS=12
ALLOW_NEAR_RESOLUTION=false

TARGET_SPREAD=0.02
MIN_TICK=0.01
ORDER_SIZE=10
# Step this many ticks inside a wide touch for better queue priority / fill rate
# (keeps >= target_spread of edge, never crosses). Set 0 to quote at the touch.
QUOTE_IMPROVE_TICKS=1
# Stop buying a market at this fraction of MAX_POSITION_PER_MARKET, tapering buy
# size as inventory fills — caps one-sided/directional risk per market.
INVENTORY_TARGET_FRACTION=0.35
# Append a pnl_snapshots row this often (seconds) for the performance chart. 0=off.
PNL_SNAPSHOT_SECONDS=300
STALE_ORDER_SECONDS=30
STALE_DATA_SECONDS=15
ALLOWED_CATEGORIES=sports,crypto,macro,politics,economics,finance

# Project token for CI deploys (Project Settings -> Tokens in Railway dashboard).
RAILWAY_TOKEN=
