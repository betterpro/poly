# Shared Railway project variables (paste into the project Variables tab or import via CLI).
# Add a PostgreSQL database first (+ New -> Database -> PostgreSQL). Default service name: Postgres.

APP_NAME=polymarket-mm-bot
ENVIRONMENT=production
LOG_LEVEL=INFO
SKIP_STARTUP_MIGRATIONS=1

PAPER_TRADING=true
LIVE_TRADING_CONFIRMED=false
RUN_MODE=paper
STARTING_CAPITAL=10000

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Private network URL — replace Postgres if your database service has a different name.
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}

POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
SIGNATURE_TYPE=0
LIVE_TOTP_SECRET=

MAX_DAILY_LOSS=300
MAX_POSITION_PER_MARKET=200
MAX_TOTAL_EXPOSURE=1000
MAX_ORDER_SIZE=25
MAX_OPEN_ORDERS=20
MAX_MARKETS_TRADED=10
MAX_API_ERRORS=5
MAX_ORDER_FAILURES_PER_MARKET=3

MIN_VOLUME=10000
MIN_LIQUIDITY=2000
MIN_SPREAD=0.01
MARKET_SCORE_THRESHOLD=70
MIN_TIME_TO_RESOLUTION_HOURS=12
ALLOW_NEAR_RESOLUTION=false

TARGET_SPREAD=0.02
MIN_TICK=0.01
ORDER_SIZE=10
STALE_ORDER_SECONDS=30
STALE_DATA_SECONDS=15

# Profitability / inventory tuning (defaults shown).
INVENTORY_SKEW_SPREAD_FRACTION=1.5
MOMENTUM_BUY_PAUSE_TICKS=2.0
MIN_EXIT_EDGE_TICKS=1.0
PNL_SNAPSHOT_INTERVAL_SECONDS=60
ALLOWED_CATEGORIES=sports,crypto,macro,politics,economics,finance
